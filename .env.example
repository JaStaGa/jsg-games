# Browser-safe Supabase configuration. Copy this file to .env.local and replace
# the placeholders with either local stack values or a project's public values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Reserved for a future server-only privileged client. Task 4A does not read or
# require this value. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_secret_key
